<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'sha256-{{ script_hash }}'; img-src data:; base-uri 'none'; form-action 'none'">
  <title>ACG Evidence Report</title>
  <style>
    :root { color-scheme: dark; --bg:#0c151c; --panel:#14242d; --line:#29404a; --text:#eaf4f3; --muted:#a4b8bc; --accent:#71d4bc; --amber:#f3c97d; --red:#f08c83; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--bg); color:var(--text); font:15px/1.5 system-ui,-apple-system,Segoe UI,sans-serif; }
    a { color:var(--accent); }
    .shell { max-width:1320px; margin:auto; padding:0 24px 64px; }
    header { border-bottom:1px solid var(--line); padding:30px 0 24px; }
    .eyebrow { color:var(--accent); font-size:.75rem; font-weight:750; letter-spacing:.17em; text-transform:uppercase; }
    h1 { margin:.25rem 0 .4rem; font-size:clamp(1.8rem,3vw,2.7rem); letter-spacing:-.04em; line-height:1.1; }
    h2 { margin:0 0 16px; font-size:1.22rem; letter-spacing:-.02em; }
    h3 { margin:0; font-size:1rem; }
    p { margin:.35rem 0; }
    .subtitle,.muted { color:var(--muted); }
    .meta { display:flex; flex-wrap:wrap; gap:8px 20px; color:var(--muted); font-size:.85rem; margin-top:16px; }
    main { display:grid; gap:28px; padding-top:28px; }
    .section-heading { display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin-bottom:14px; }
    .section-heading p { font-size:.82rem; color:var(--muted); }
    .cards { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }
    .card { background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:18px; min-height:112px; }
    .card .label { display:block; color:var(--muted); font-size:.77rem; text-transform:uppercase; letter-spacing:.08em; }
    .card strong { display:block; margin-top:10px; font-size:1.85rem; font-variant-numeric:tabular-nums; line-height:1; }
    .card.primary { border-color:#438b80; }
    .card.primary strong { color:var(--accent); }
    .metric-groups { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
    .metric-group { background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:16px; }
    .metric-group h3 { color:var(--accent); margin-bottom:8px; }
    .metric-group dl { display:grid; grid-template-columns:1fr auto; gap:5px 14px; margin:0; }
    .metric-group dt { color:var(--muted); }
    .metric-group dd { margin:0; font-variant-numeric:tabular-nums; font-weight:700; }
    .filters { display:flex; flex-wrap:wrap; align-items:end; gap:10px; margin-bottom:12px; }
    .filters label { display:grid; gap:4px; color:var(--muted); font-size:.82rem; }
    .filters select { min-width:145px; background:var(--panel); color:var(--text); border:1px solid var(--line); border-radius:5px; padding:8px; font:inherit; }
    .filters select:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
    .filters output { color:var(--muted); font-size:.82rem; margin-left:auto; padding-bottom:8px; }
    .panel { background:var(--panel); border:1px solid var(--line); border-radius:8px; overflow:hidden; }
    .table-scroll { overflow-x:auto; }
    table { width:100%; border-collapse:collapse; text-align:left; }
    th,td { padding:12px 14px; border-bottom:1px solid var(--line); vertical-align:top; }
    th { color:var(--muted); font-size:.74rem; letter-spacing:.07em; text-transform:uppercase; white-space:nowrap; }
    tbody tr:last-child td { border-bottom:0; }
    .rule { color:var(--accent); font-weight:700; white-space:nowrap; }
    .resource { font-family:ui-monospace,SFMono-Regular,Consolas,monospace; font-size:.83rem; overflow-wrap:anywhere; }
    .badge { display:inline-block; padding:2px 8px; border:1px solid currentColor; border-radius:4px; font-size:.75rem; font-weight:700; white-space:nowrap; }
    .badge.CRITICAL,.badge.ESCALATED_CRITICAL { color:var(--red); }
    .badge.WARNING { color:var(--amber); }
    .timeline { list-style:none; padding:4px 20px 8px; margin:0; }
    .timeline li { border-left:2px solid var(--line); padding:10px 0 14px 20px; position:relative; }
    .timeline li::before { content:""; position:absolute; width:8px; height:8px; border-radius:50%; background:var(--accent); left:-5px; top:18px; }
    .timeline time { display:block; color:var(--muted); font-size:.77rem; }
    .timeline .event { font-weight:700; }
    .timeline .detail { color:var(--muted); font-size:.83rem; }
    .note { border-left:3px solid var(--amber); padding:10px 14px; background:#2a2a25; color:#f7e4c4; }
    .stack-gap { margin-top:12px; }
    .empty { color:var(--muted); padding:20px; }
    footer { border-top:1px solid var(--line); margin-top:32px; padding-top:20px; color:var(--muted); font-size:.82rem; }
    @media (max-width:900px) { .cards { grid-template-columns:repeat(2,minmax(0,1fr)); } .metric-groups { grid-template-columns:1fr; } }
    @media (max-width:560px) { .shell { padding-left:16px; padding-right:16px; } .cards { grid-template-columns:repeat(2,minmax(0,1fr)); } .card { padding:14px; min-height:102px; } .card strong { font-size:1.5rem; } .section-heading { display:block; } }
  </style>
</head>
<body>
  <div class="shell">
    <header>
      <div class="eyebrow">Azure Compliance Guard / Evidence</div>
      <h1>Compliance snapshot</h1>
      <p class="subtitle">Static, offline report from append-only local evidence.</p>
      <div class="meta"><span>{{ source_label }}</span><span>Generated {{ generated_at }}</span><span>Public identifiers are pseudonymized</span></div>
    </header>
    <main>
      <section aria-labelledby="overview-title">
        <div class="section-heading"><h2 id="overview-title">Overview</h2><p>Compliance is evaluated rules without findings / all evaluated rules.</p></div>
        <div class="cards">
          <div class="card primary"><span class="label">Compliance</span><strong>{{ summary.compliance }}</strong></div>
          <div class="card"><span class="label">PASS</span><strong>{{ summary.pass }}</strong></div>
          <div class="card"><span class="label">WARNING</span><strong>{{ summary.warning }}</strong></div>
          <div class="card"><span class="label">CRITICAL</span><strong>{{ summary.critical }}</strong></div>
          <div class="card"><span class="label">Resources scanned</span><strong>{{ summary.resources }}</strong></div>
          <div class="card"><span class="label">Rules evaluated</span><strong>{{ summary.rules }}</strong></div>
          <div class="card"><span class="label">Scan duration</span><strong>{{ summary.duration_ms }}<small> ms</small></strong></div>
          <div class="card"><span class="label">Findings</span><strong>{{ findings|length }}</strong></div>
        </div>
      </section>
      <section aria-labelledby="lifecycle-title">
        <div class="section-heading"><h2 id="lifecycle-title">Lifecycle metrics</h2><p>N/A means there is no outcome denominator.</p></div>
        <div class="metric-groups">
          <div class="metric-group"><h3>Remediation</h3><dl><dt>Plans generated</dt><dd>{{ remediation.planned }}</dd><dt>Approved</dt><dd>{{ remediation.approved }}</dd><dt>Verified</dt><dd>{{ remediation.verified }}</dd><dt>Verification failed</dt><dd>{{ remediation.failed }}</dd><dt>Success rate</dt><dd>{{ remediation.success_rate }}</dd><dt>Mean verification time</dt><dd>{{ remediation.mean_verification_ms }}{% if remediation.mean_verification_ms != 'N/A' %} ms{% endif %}</dd></dl></div>
          <div class="metric-group"><h3>Exceptions</h3><dl><dt>Active</dt><dd>{{ exceptions.active }}</dd><dt>Expired</dt><dd>{{ exceptions.expired }}</dd><dt>Revoked</dt><dd>{{ exceptions.revoked }}</dd><dt>Incident revoked</dt><dd>{{ exceptions.incident_revoked }}</dd></dl></div>
          <div class="metric-group"><h3>Incidents</h3><dl><dt>Security events evaluated</dt><dd>{{ incidents.security_events_evaluated }}</dd><dt>Escalated events</dt><dd>{{ incidents.escalated }}</dd></dl></div>
        </div>
      </section>
      <section aria-labelledby="findings-title">
        <div class="section-heading"><h2 id="findings-title">Findings</h2><p>Observed drift from evaluated rules</p></div>
        <div class="filters" role="group" aria-label="Filter findings">
          <label for="service-filter">Service<select id="service-filter"><option value="all">All services</option><option value="storage">Storage</option><option value="key_vault">Key Vault</option><option value="sql">SQL</option></select></label>
          <label for="severity-filter">Severity<select id="severity-filter"><option value="all">All severities</option><option value="WARNING">Warning</option><option value="CRITICAL">Critical</option><option value="ESCALATED_CRITICAL">Escalated critical</option></select></label>
          <label for="status-filter">Status<select id="status-filter"><option value="all">All statuses</option><option value="FAIL">Fail</option><option value="PASS">Pass</option></select></label>
          <output id="filter-count" role="status">{{ findings|length }} finding(s)</output>
        </div>
        <div class="panel table-scroll">
          {% if findings %}
          <table><thead><tr><th scope="col">Rule / title</th><th scope="col">Service</th><th scope="col">Severity / status</th><th scope="col">Resource</th><th scope="col">Expected</th><th scope="col">Actual</th><th scope="col">Exception</th><th scope="col">Remediation</th></tr></thead><tbody>
            {% for event in findings %}
            <tr data-service="{{ event.resource.service }}" data-severity="{{ event.data.severity }}" data-status="{{ event.data.status }}"><td><span class="rule">{{ event.data.rule_id }}</span><br>{{ event.data.title }}</td><td>{{ event.resource.service }}</td><td><span class="badge {{ event.data.severity }}">{{ event.data.severity }}</span><br>{{ event.data.status }}</td><td class="resource">{{ event.resource.name }}</td><td>{{ event.data.expected }}</td><td>{{ event.data.actual }}</td><td>{{ event.exception_state }}</td><td>{{ event.remediation_state }}</td></tr>
            {% endfor %}
          </tbody></table>
          {% else %}<p class="empty">No findings were recorded in this evidence stream.</p>{% endif %}
        </div>
      </section>
      <section aria-labelledby="timeline-title">
        <div class="section-heading"><h2 id="timeline-title">Timeline</h2><p>Events in timestamp order</p></div>
        <div class="panel"><ol class="timeline">
          {% for event in timeline %}
          <li><time datetime="{{ event.timestamp }}">{{ event.timestamp }}</time><div class="event">{{ event.event_type|replace('_', ' ') }}</div><div class="detail">{{ event.source }} · {{ event.collector }}{% if event.resource %} · {{ event.resource.name }}{% endif %}{% if event.data.get('operation') %} · {{ event.data.operation }}{% endif %}{% if event.data.get('severity') %} · {{ event.data.severity }}{% endif %}{% if event.data.get('action') %} · {{ event.data.action }}{% endif %}{% if event.data.get('verification') %} · verification {{ event.data.verification }}{% endif %}</div></li>
          {% endfor %}
        </ol></div>
      </section>
      <section aria-labelledby="validation-title">
        <div class="section-heading"><h2 id="validation-title">External validation</h2><p>Detection credibility is separate from remediation lifecycle.</p></div>
        <div class="note"><strong>UNVERIFIED external agreement.</strong> Prowler and Azure Policy were not run. Fixture-only results do not establish live accuracy or exact control mapping.</div>
        <div class="panel table-scroll stack-gap"><table><tbody>
          <tr><th scope="row">Scope / cases</th><td>{{ validation.scope }} · {{ validation.case_count }} case(s) · {{ validation.run_at }}</td></tr>
          <tr><th scope="row">Versions</th><td>ACG {{ validation.acg_version }} · Rule catalog schema {{ validation.catalog_version }} · Prowler {{ validation.prowler_version }} · Azure Policy {{ validation.azure_policy_version }}</td></tr>
          <tr><th scope="row">Supported rule coverage</th><td>{{ validation.covered_rules }} / {{ validation.catalog_rules }} internal rules represented</td></tr>
          <tr><th scope="row">Fixture confusion matrix</th><td>TP {{ validation.tp }} · TN {{ validation.tn }} · FP {{ validation.fp }} · FN {{ validation.fn }}</td></tr>
          <tr><th scope="row">Exact-mapping agreement</th><td>{{ validation.exact_agreement }}</td></tr>
        </tbody></table></div>
        {% if validation.cases %}<div class="panel table-scroll stack-gap"><table><thead><tr><th scope="col">Case</th><th scope="col">TP</th><th scope="col">TN</th><th scope="col">FP</th><th scope="col">FN</th><th scope="col">Mapping</th></tr></thead><tbody>
          {% for case in validation.cases %}<tr><td>{{ case.case_id }}</td><td>{{ case.tp }}</td><td>{{ case.tn }}</td><td>{{ case.fp }}</td><td>{{ case.fn }}</td><td>{{ case.mapping_status }}</td></tr>{% endfor %}
        </tbody></table></div>{% else %}<p class="muted">No case comparison was supplied; disagreement review is pending.</p>{% endif %}
      </section>
    </main>
    <footer>Azure Compliance Guard · Offline evidence report · No Azure account or web server required</footer>
  </div>
  <script>
    const controls = ["service", "severity", "status"].map(name => document.getElementById(`${name}-filter`));
    const rows = [...document.querySelectorAll("tr[data-service]")];
    const count = document.getElementById("filter-count");
    function filterRows() {
      let visible = 0;
      for (const row of rows) {
        row.hidden = controls.some((control, index) => control.value !== "all" && control.value !== row.dataset[["service", "severity", "status"][index]]);
        if (!row.hidden) visible++;
      }
      count.textContent = `${visible} finding(s)`;
    }
    for (const control of controls) control.addEventListener("change", filterRows);
  </script>
</body>
</html>
